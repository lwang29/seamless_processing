# Read-only source-data mounts and the research-licensed body model.
seamless_interaction
datasets
model_files
seamless_interaction_clean

# Session-local Git metadata from the v0 rounds, when the platform mounted .git
# read-only. Its 71 commits are also in this repository as the `v0-history`
# branch; do not delete it without checking that first.
.git-session/

# Local environments and caches.
.conda/
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.py[cod]

# Pipeline outputs: tables, manifests, and the run report. Regenerated by the
# stages; the accepted manifest is the deliverable but it is participant-derived
# and belongs to the run directory, not to Git.
outputs/

# Private participant-media derivatives: review cards and clips, mode 0600 in a
# 0700 directory. These never leave the cluster.
artifacts
work/

# Slurm needs the log directory to exist before sbatch can open its output path.
slurm/logs/*.out
slurm/logs/*.err
slurm/logs/*.log
!slurm/logs/.gitkeep

# Staged review site: contains participant media and a plaintext password.
dist/
